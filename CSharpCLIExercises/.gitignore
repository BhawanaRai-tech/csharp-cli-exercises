## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
*.vsp
*.vspx
*.sap

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
*.snupkg
*.nuspec
*.symbols.nupkg
*.nupkg.metadata
*.nupkg.sha512
packages/
*.nupkg
*.sln.ide

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Publish files
*.pubxml
*.publishproj

# Windows Store app package directories and files
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx

# Others
*.cache
*.ilk
*.log
*.obj
*.pdb
*.sdf
*.tmp
*.tmp_proj
*.vshost.exe
*.vshost.exe.config
*.vshost.exe.manifest

# Database files
*.mdf
*.ldf

# Visual Studio (other)
*.vspscc
*.vssscc
*.iobj
*.ipdb
*.ipdb
*.sbr
*.vcxproj.filters
*.vsix

# Node.js (for JavaScript projects inside C#)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json